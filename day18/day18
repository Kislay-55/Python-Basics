import re
from collections import Counter

paragraph = 'I love teaching. If you do not love teaching what else can you love. I love Python if you do not love something which can give you all the capabilities to develop an application what else can you love.'
words = re.findall(r'\w+', paragraph)
word_counts = Counter([word.lower() for word in words])
most_frequent_word = word_counts.most_common(1)[0][0]
print("Most frequent word:", most_frequent_word)


text = "The position of some particles on the horizontal x-axis are -12, -4, -3 and -1 in the negative direction, 0 at origin, 4 and 8 in the positive direction."
points = [int(num) for num in re.findall(r'-?\d+', text)]
sorted_points = sorted(points)
distance = max(sorted_points) - min(sorted_points)
print("Sorted points:", sorted_points)
print("Distance:", distance)


def is_valid_variable(variable_name):
    pattern = r'^[a-zA-Z_][a-zA-Z0-9_]*$'
    return bool(re.match(pattern, variable_name))

print("is_valid_variable('first_name'):", is_valid_variable('first_name'))
print("is_valid_variable('first-name'):", is_valid_variable('first-name'))
print("is_valid_variable('1first_name'):", is_valid_variable('1first_name'))
print("is_valid_variable('firstname'):", is_valid_variable('firstname'))


sentence = '''%I $am@% a %tea@cher%, &and& I lo%#ve %tea@ching%;. There $is nothing; &as& mo@re rewarding as educa@ting &and& @emp%o@wering peo@ple. ;I found tea@ching m%o@re interesting tha@n any other %jo@bs. %Do@es thi%s mo@tivate yo@u to be a tea@cher!?'''

def clean_text(text):
    return re.sub(r'[^a-zA-Z\s]', '', text)

def most_frequent_words(text):
    words = text.split()
    counts = Counter(words)
    sorted_words = sorted([(count, word) for word, count in counts.items()], reverse=True)
    return sorted_words[:3]

cleaned_text = clean_text(sentence)
print("Cleaned text:", cleaned_text)
print("Most frequent words:", most_frequent_words(cleaned_text))