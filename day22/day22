import json
import requests
from bs4 import BeautifulSoup

# --- 1. Boston University Facts & Stats ---
url_bu = 'http://www.bu.edu/president/boston-university-facts-stats/'
res_bu = requests.get(url_bu)
soup_bu = BeautifulSoup(res_bu.content, 'html.parser')

data_bu = {}
for sec in soup_bu.find_all(['div', 'section']):
    title = sec.find(['h2', 'h3', 'h4'])
    facts = sec.find_all(['li', 'p'])
    if title and facts:
        key = title.get_text(strip=True)
        values = [f.get_text(strip=True) for f in facts if f.get_text(strip=True)]
        if values:
            data_bu[key] = values

with open('bu_facts.json', 'w', encoding='utf-8') as f:
    json.dump(data_bu, f, indent=4, ensure_ascii=False)


# --- 2. UCI ML Datasets ---
url_uci = 'https://archive.ics.uci.edu/ml/datasets.php'
res_uci = requests.get(url_uci)
soup_uci = BeautifulSoup(res_uci.content, 'html.parser')

target_table = None
for table in soup_uci.find_all('table'):
    if 'Name' in table.text and 'Data Type' in table.text:
        target_table = table
        break

data_uci = []
if target_table:
    for row in target_table.find_all('tr')[1:]:
        cols = row.find_all('td')
        if len(cols) >= 7:
            item = {
                'Name': cols[0].get_text(strip=True),
                'Data_Type': cols[1].get_text(strip=True),
                'Default_Task': cols[2].get_text(strip=True),
                'Attribute_Types': cols[3].get_text(strip=True),
                'Instances': cols[4].get_text(strip=True),
                'Attributes': cols[5].get_text(strip=True),
                'Year': cols[6].get_text(strip=True)
            }
            if item['Name']:
                data_uci.append(item)

with open('uci_datasets.json', 'w', encoding='utf-8') as f:
    json.dump(data_uci, f, indent=4, ensure_ascii=False)


# --- 3. Wikipedia US Presidents ---
url_wiki = 'https://en.wikipedia.org/wiki/List_of_presidents_of_the_United_States'
headers = {'User-Agent': 'Mozilla/5.0'}
res_wiki = requests.get(url_wiki, headers=headers)
soup_wiki = BeautifulSoup(res_wiki.content, 'html.parser')

table_wiki = soup_wiki.find('table', {'class': 'wikitable'})
data_presidents = []

if table_wiki:
    for row in table_wiki.find_all('tr')[1:]:
        cols = row.find_all(['th', 'td'])
        if len(cols) >= 5:
            row_data = [col.get_text(separator=' ', strip=True) for col in cols]
            data_presidents.append({'data': row_data})

with open('us_presidents.json', 'w', encoding='utf-8') as f:
    json.dump(data_presidents, f, indent=4, ensure_ascii=False)