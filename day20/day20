import json
import re
import statistics
import urllib.request
from collections import Counter
from bs4 import BeautifulSoup


# 1. 10 most frequent words in Romeo and Juliet from URL
def get_romeo_and_juliet_top_words(url='http://www.gutenberg.org/files/1112/1112.txt', limit=10):
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    with urllib.request.urlopen(req) as response:
        text = response.read().decode('utf-8')
    words = re.findall(r'\b[a-zA-Z]+\b', text.lower())
    return [(count, word) for word, count in Counter(words).most_common(limit)]


# 2. Cats API analysis
def analyze_cats_api(url='https://api.thecatapi.com/v1/breeds'):
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    with urllib.request.urlopen(req) as response:
        cats_data = json.loads(response.read().decode('utf-8'))

    weights = []
    lifespans = []
    country_breed_freq = {}

    for cat in cats_data:
        if 'weight' in cat and 'metric' in cat['weight']:
            parts = [float(x.strip()) for x in cat['weight']['metric'].split('-') if x.strip().replace('.', '', 1).isdigit()]
            if parts:
                weights.append(sum(parts) / len(parts))

        if 'life_span' in cat:
            parts = [float(x.strip()) for x in cat['life_span'].split('-') if x.strip().replace('.', '', 1).isdigit()]
            if parts:
                lifespans.append(sum(parts) / len(parts))

        origin = cat.get('origin', 'Unknown')
        breed = cat.get('name', 'Unknown')
        country_breed_freq[origin] = country_breed_freq.get(origin, 0) + 1

    def get_stats(data):
        return {
            'min': min(data),
            'max': max(data),
            'mean': statistics.mean(data),
            'median': statistics.median(data),
            'std_dev': statistics.stdev(data)
        }

    return {
        'weight_stats': get_stats(weights),
        'lifespan_stats': get_stats(lifespans),
        'country_breed_frequency': country_breed_freq
    }


# 3. Countries API analysis
def analyze_countries_api(url='https://restcountries.com/v2/all'):
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    with urllib.request.urlopen(req) as response:
        countries_data = json.loads(response.read().decode('utf-8'))

    countries_by_area = sorted(
        [c for c in countries_data if 'area' in c],
        key=lambda x: x['area'],
        reverse=True
    )
    top_10_largest = [{'country': c['name'], 'area': c['area']} for c in countries_by_area[:10]]

    languages_counter = Counter()
    all_languages = set()

    for c in countries_data:
        for lang in c.get('languages', []):
            lang_name = lang.get('name')
            if lang_name:
                languages_counter[lang_name] += 1
                all_languages.add(lang_name)

    top_10_languages = [(count, lang) for lang, count in languages_counter.most_common(10)]

    return {
        '10_largest_countries': top_10_largest,
        '10_most_spoken_languages': top_10_languages,
        'total_languages': len(all_languages)
    }


# 4. UCI Machine Learning Repository Scraper
def parse_uci_datasets(url='https://archive.ics.uci.edu/ml/datasets.php'):
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    try:
        with urllib.request.urlopen(req) as response:
            html = response.read().decode('utf-8', errors='ignore')
        soup = BeautifulSoup(html, 'html.parser')
        datasets = []
        for p in soup.find_all(['p', 'a', 'td']):
            text = p.get_text(strip=True)
            if text and len(text) > 3:
                datasets.append(text)
        return datasets[:20]
    except Exception as e:
        return f"Could not fetch UCI datasets: {e}"


